# H.E.A.R.T. AI Environment Configuration
# Copy this file to .env and configure your local settings.
# NEVER commit real API keys or secrets to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Device Configuration (cpu, cuda, mps)
DEVICE=cpu

# LLM Provider Configuration (Optional / Phase 8)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model Cache Directories
HF_HOME=./models/cache
TORCH_HOME=./models/cache

# Data Paths
DATA_DIR=./data
MELD_RAW_PATH=./data/raw/MELD
MELD_PROCESSED_PATH=./data/processed/meld

# Experiment Output Directory
RESULTS_DIR=./results
LOGS_DIR=./logs
